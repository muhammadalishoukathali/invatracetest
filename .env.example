# Public frontend build configuration. Never place secrets in VITE_ variables.
VITE_API_BASE_URL=http://localhost:8000
VITE_MODEL_BASE_URL=/models/pulih-model1-v4
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=OpenStreetMap contributors
VITE_RELEASE_ID=dev
VITE_ENABLE_MOCKS=true
VITE_ENABLE_FAKE_MODEL=false
VITE_ENABLE_REAL_MODEL=true
VITE_HTTPS=false
