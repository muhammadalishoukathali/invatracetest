{
  "name": "invatrace-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "pack:assets": "node scripts/pack-runtime-assets.mjs",
    "prepare:model": "node scripts/prepare-model-assets.mjs",
    "catalogue:refresh": "node scripts/update-catalogue-manifest.mjs",
    "predev": "npm run prepare:model",
    "dev": "cross-env NODE_OPTIONS=--max-http-header-size=65536 vite --host",
    "predev:https": "npm run prepare:model",
    "dev:https": "cross-env VITE_HTTPS=true NODE_OPTIONS=--max-http-header-size=65536 vite --host",
    "predev:model-test": "npm run prepare:model",
    "dev:model-test": "vite --host --mode model-test --port 5174",
    "predev:real": "npm run prepare:model",
    "dev:real": "cross-env VITE_ENABLE_MOCKS=false VITE_ENABLE_FAKE_MODEL=false VITE_API_BASE_URL=http://localhost:8000 vite --host",
    "prebuild": "npm run prepare:model",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test a11y.spec.ts",
    "check:latency": "node scripts/latency-budget-check.mjs",
    "test:e2e:model-ui": "playwright test --config=playwright.model.config.ts",
    "test:e2e:real": "playwright test --config=playwright.real.config.ts",
    "test:e2e:pwa": "playwright test --config=playwright.pwa.config.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@tanstack/react-query": "^5.62.0",
    "lucide-react": "^0.475.0",
    "maplibre-gl": "^6.5.0",
    "onnxruntime-web": "1.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "msw": "^2.7.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "4.1.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
