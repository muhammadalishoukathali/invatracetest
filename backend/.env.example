APP_ENV=development
DATABASE_URL=postgresql+psycopg://invatrace:invatrace@localhost:5432/invatrace
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173

# Replace every development value before production deployment.
JWT_SECRET=replace-with-at-least-32-random-bytes
CREDENTIAL_HASH_KEY=replace-with-a-separate-random-key
LOCATION_PRIVACY_KEY=replace-with-a-third-random-key
ACCESS_TOKEN_TTL_MINUTES=15
RATE_LIMIT_ENABLED=true

S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=invatrace-private
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_BYTES=8388608
UPLOAD_URL_TTL_SECONDS=900
UPLOAD_ACTIVE_GRANTS_PER_PROFILE=10
UPLOAD_CLEANUP_INTERVAL_SECONDS=3600

# fake is allowed only in development/test. Production defaults to unavailable.
PLANT_MODEL_PROVIDER=fake
PLANT_MODEL_VERSION=fake-dev-v1
PLANT_MODEL_DEVICE=cpu
PLANT_MODEL_TIMEOUT_SECONDS=20
WORKER_POLL_SECONDS=2
WORKER_MAX_ATTEMPTS=5
WORKER_JOB_LEASE_SECONDS=300
