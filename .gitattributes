# Force LF everywhere so shell fragments, mounted JSON, and Compose entrypoints
# stay valid when the repo is cloned on Windows (git default is CRLF there).
* text=auto eol=lf

*.sh text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
Dockerfile text eol=lf

# Binary — never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.onnx binary
*.woff binary
*.woff2 binary
